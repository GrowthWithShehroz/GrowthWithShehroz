# Copy to .env and fill in your real credentials before running `eas build`.
# All EXPO_PUBLIC_* vars are inlined into the JS bundle at build time.

# --- Firebase (Android) ---
# Path to google-services.json downloaded from Firebase Console.
# Default location is ./android/google-services.json — override only if you keep it elsewhere.
GOOGLE_SERVICES_JSON=./android/google-services.json

# --- Google AdMob ---
# Use Google's documented test app ID in development:
#   ca-app-pub-3940256099942544~3347511713
# Replace with your real AdMob app ID for production builds only.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713

# AdMob unit IDs. Test IDs work in dev; replace for production.
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=ca-app-pub-3940256099942544/1033173712

# --- RevenueCat ---
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_PREMIUM_ENTITLEMENT=premium

# --- Instagram Stories share (optional) ---
# Required for "Share to Instagram Stories". Get it from developers.facebook.com.
EXPO_PUBLIC_FACEBOOK_APP_ID=

# --- EAS ---
EAS_PROJECT_ID=
