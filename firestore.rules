rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /completions/{date} {
        allow read, write: if isOwner(uid);
      }
    }

    match /wisdom/{date} {
      allow read: if true;
      allow write: if false;
    }
  }
}
